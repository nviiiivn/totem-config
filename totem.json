{
  "$schema": "https://totem.local/config.json",
  "autoupdate": false,
  "disabled_providers": [
    "anthropic"
  ],
  "plugin": [
    [
      "file:///home/nvii/projects/totemic/totem-pole/totempole",
      {
        "enabled": true
      }
    ],
    [
      "file:///home/nvii/projects/totemic/totem/totem-log-sanitizer",
      {
        "enabled": true
      }
    ],
    [
      "file:///home/nvii/.config/totem/plugins/session-transcript.mjs",
      {
        "enabled": true
      }
    ],
    [
      "opencode-mem",
      {
        "enabled": true
      }
    ],
    [
      "opencode-pty",
      {
        "enabled": true
      }
    ],
    [
      "@tarquinen/opencode-dcp",
      {
        "enabled": true
      }
    ],
    [
      "workaholic",
      {
        "enabled": false
      }
    ],
    [
      "opencode-notify",
      {
        "enabled": false
      }
    ],
    [
      "opencode-worktree",
      {
        "enabled": true
      }
    ],
    [
      "opencode-local-ollama",
      {
        "enabled": true
      }
    ],
    "opencode-usage-monitor",
    [
      "psinetron-opencode-visualizer",
      {
        "enabled": false
      }
    ],
    "opencode-froggy",
    "opencode-beads",
    "opencode-mystatus",
    "opencode-token-tracker",
    "opencode-telemetry",
    "opencode-history-search",
    "opencode-plan-manager",
    "opencode-background-agents",
    "opencode-adaptive-thinking",
    [
      "file:///home/nvii/projects/lolcat-theme/dist/tui.mjs",
      {
        "enabled": true
      }
    ]
  ],
  "compaction": {
    "reserved": 8000,
    "tail_turns": 4,
    "preserve_recent_tokens": 16000
  },
  "model": "zai/glm-5.2",
  "small_model": "zai/glm-4.7-flash",
  "agent": {
    "build": {
      "model": "zai/glm-5.2",
      "prompt": "You follow the CONSTITUTION rules at all times. Direct, peer-level. Answer what was asked, nothing else. Deliver complete work, no stubs. Corrections are silent — fix and move on. No emotional labeling. No disclaimers, apologies, or ceremonial compliance."
    },
    "plan": {
      "model": "zai/glm-4.7-flash",
      "prompt": "You follow the CONSTITUTION. Keep plans specific and actionable. No status updates, no emotional observations, no general advice. Answer exactly what was asked."
    },
    "orchestrator": {
      "model": "zai/glm-5.2",
      "prompt": "You are the Orchestrator. Your role is master orchestration and coordination of complex tasks. You handle multi-step state management, complex triage, intent analysis, and cross-agent coordination.",
      "subAgents": {
        "researcher": {
          "model": "zai/glm-5.2",
          "prompt": "You are the Researcher. You perform deep dive investigation, data synthesis, documentation scraping, and exploration-first discovery."
        },
        "debugger": {
          "model": "zai/glm-5.2",
          "prompt": "You are the Debugger. You perform non-linear troubleshooting, root cause triangulation, and fix broken loops."
        },
        "auditor": {
          "model": "zai/glm-5.2",
          "prompt": "You are the Auditor. You are the final gatekeeper for AI slop detection, security checks, style alignment, and verification against original requirements."
        }
      }
    },
    "architect": {
      "model": "zai/glm-5.2",
      "prompt": "You are the Architect. Your role is systems architecture for high-level design and blueprinting. You handle requirement gathering, product sense, roadmap generation, and transitioning human ideas to technical specs.",
      "subAgents": {
        "researcher": {
          "model": "zai/glm-5.2",
          "prompt": "You are the Researcher. You perform deep dive investigation, data synthesis, documentation scraping, and exploration-first discovery."
        },
        "auditor": {
          "model": "zai/glm-5.2",
          "prompt": "You are the Auditor. You are the final gatekeeper for AI slop detection, security checks, style alignment, and verification against original requirements."
        }
      }
    },
    "engineer": {
      "model": "zai/glm-5.2",
      "prompt": "You are the Engineer. Your role is implementation specialist for robust, production-ready code. You handle high-fidelity code production, standard adherence, and performance optimization.",
      "subAgents": {
        "debugger": {
          "model": "zai/glm-5.2",
          "prompt": "You are the Debugger. You perform non-linear troubleshooting, root cause triangulation, and fix broken loops."
        },
        "auditor": {
          "model": "zai/glm-5.2",
          "prompt": "You are the Auditor. You are the final gatekeeper for AI slop detection, security checks, style alignment, and verification against original requirements."
        }
      }
    },
    "operator": {
      "model": "zai/glm-5.2",
      "prompt": "You are the Operator. Your role is systems operator and deployment specialist. You handle deployment scripts, Docker optimization, CI/CD pipelines, environment troubleshooting, and infrastructure management.",
      "subAgents": {
        "debugger": {
          "model": "zai/glm-5.2",
          "prompt": "You are the Debugger. You perform non-linear troubleshooting, root cause triangulation, and fix broken loops."
        }
      }
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-searxng"
      ],
      "environment": {
        "SEARXNG_URL": "http://localhost:8888"
      },
      "enabled": false
    },
    "flet": {
      "type": "local",
      "command": [
        "/home/nvii/venvs/flet/bin/flet-mcp-server"
      ],
      "enabled": false
    },
    "zai-search": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ENV:ZHIPU_API_KEY"
      }
    },
    "zai-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ENV:ZHIPU_API_KEY"
      }
    },
    "zai-zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ENV:ZHIPU_API_KEY"
      }
    },
    "reddit": {
      "type": "local",
      "command": [
        "/home/nvii/.local/npm-global/bin/reddit-mcp-buddy"
      ],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "stv": {
      "type": "remote",
      "url": "http://127.0.0.1:8801/mcp",
      "enabled": true
    },
    "osm": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<2",
        "osm-mcp-server"
      ],
      "enabled": false
    },
    "geowire": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@geowirehq/mcp"
      ],
      "enabled": false
    },
    "fetcher": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "fetcher-mcp"
      ],
      "enabled": true
    },
    "remoteopenclaw": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "remoteopenclaw"
      ],
      "enabled": false
    },
    "reddit-research": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.dialog.tools/mcp"
      ],
      "enabled": false
    },
    "chat-export": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "opencode-chat-export",
        "--with",
        "mcp<2",
        "opencode-chat-export"
      ],
      "enabled": true
    },
    "github": {
      "type": "url",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ***REMOVED***"
      }
    }
  },
